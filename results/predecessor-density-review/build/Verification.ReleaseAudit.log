theorem CollatzPredecessorDensity.predecessors_positive_lower_density : ∀ {a : ℕ},
  0 < a → ¬3 ∣ a → HasPositiveLowerDensity (predecessors a) :=
fun {a} ha hthree ↦ Erdos1135.ND.PositiveDensity.generalTarget_predecessors_positive_lower_density ha hthree
theorem CollatzPredecessorDensity.nonconvergence_positive_lower_density_of_counterexample : (∃ n,
    0 < n ∧ ¬Reaches n 1) →
  HasPositiveLowerDensity nonconvergentStarts :=
fun hbad ↦ Erdos1135.ND.PositiveDensity.positive_nonconvergence_lower_density_of_counterexample hbad
theorem CollatzPredecessorDensity.universal_reaches_one_of_arbitrarily_dense_convergence : ArbitrarilyDenseConvergence →
  ∀ (n : ℕ), 0 < n → Reaches n 1 :=
fun hstat ↦ Erdos1135.ND.PositiveDensity.universal_reaches_one_of_arbitrarily_dense_convergence hstat
