theorem closed_prefix_tail_zero : tailSum (prefixMinimum 128) 4 256 = 0 := by
  apply checks_floor_range_sound 4 128 256 paths
  decide +kernel

theorem closed_prefix_tail_stays_zero (t : Nat) (ht : 128 ≤ t) :
    tailSum (prefixMinimum t) 4 256 = 0 := by
  have hl := sum_mono (tailTerm (prefixMinimum t) 4) (tailTerm (prefixMinimum 128) 4) 256
    (fun n _ _ => tail_term_mono _ _ 4 n (prefix_clock_mono ht n))
  change tailSum (prefixMinimum t) 4 256 ≤ tailSum (prefixMinimum 128) 4 256 at hl
  rw [closed_prefix_tail_zero] at hl
  omega

theorem all_late_signed_cancellation (t : Nat) (ht : 128 ≤ t) :
    clockOccupation 4 t (residual (tailMean 4)) t 256 ≤ -(103 : Rat) / 2 := by
  have hb := every_clock_boundary_256 t
  have he := clocked_exact_unroll 4 t (tailMean 4) t 256
  have hz : tailMean 4 t 256 = 0 := by
    simp only [tailMean, closed_prefix_tail_stays_zero t ht]
    change (0 : Rat) * (256 : Rat)⁻¹ = 0
    exact Rat.zero_mul _
  rw [hz] at he
  grind

#print axioms closed_prefix_tail_zero
#print axioms closed_prefix_tail_stays_zero
#print axioms all_late_signed_cancellation

