/- Exact inputs to the written quadratic valuation rank obstruction.
Real-valued properness and the polynomial growth arguments are not formalized.
This is not a proof of Collatz. -/
import ValuationGraphRank
import GraphRankNecessity
namespace QuadraticValuationRank
open ValuationGraphRank (Features ExactVal)

theorem features_151 (q : Nat) :
    Features (144*q+151) 0 3 0 0 ∧
    Features (216*q+227) 0 2 0 1 ∧
    Features (288*q+302) 1 0 0 1 := by
  simp only [Features, ExactVal]
  omega

theorem neighbors_151 (q : Nat) :
    CollatzAffine.U (144*q+151) = (216*q+227) ∧
    CollatzAffine.U (288*q+302) = 144*q+151 ∧
    (144*q+151) % 3 = 1 := by
  unfold CollatzAffine.U
  simp only [show (144*q+151) % 2 = 1 by omega,
    show (288*q+302) % 2 = 0 by omega, reduceIte, Nat.reduceEqDiff]
  omega

